# Keep your existing local connection string in .env; replace these placeholders.
DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5436/payflow
# Generate a random key (do not use a sample string). See README.md.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15

# development, test or demo. demo requires HTTPS origins and DB sslmode=require/verify-*.
PAYFLOW_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PAYFLOW_EXPOSE_DOCS=1
LOG_LEVEL=INFO
# Used by python -m serve (Docker/cloud), not the development uvicorn command.
PORT=8001
WEB_CONCURRENCY=1
PAYFLOW_MAX_CONCURRENCY=16

# Payment security: demo defaults, exact decimal amounts; never put PINs here.
PAYMENT_SINGLE_LIMIT=100000.00
PAYMENT_DAILY_LIMIT=200000.00
PAYMENT_DAILY_COUNT=50
REQUEST_DAILY_COUNT=20
PIN_MAX_ATTEMPTS=5
PIN_LOCK_SECONDS=900
PAYMENT_AUTH_SECONDS=120
LOGIN_IP_LIMIT=30
LOGIN_IDENTITY_LIMIT=10
REGISTER_IP_LIMIT=10
PIN_RATE_LIMIT=10
PAYMENT_RATE_LIMIT=30
RISK_VELOCITY_COUNT=8
RISK_DISTINCT_RECIPIENTS=5
RISK_BLOCK_AMOUNT=75000.00
RISK_REVIEW_AMOUNT=10000.00
RISK_INSUFFICIENT_COUNT=5
RISK_SERVICE_COUNT=8
RISK_NEW_CONTACT_COUNT=3
RISK_REQUEST_COUNT=10
SECURITY_RETENTION_DAYS=90

# Per-process database budget; reserve DB connections for workers and operators.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_POLL_SECONDS=1
# Empty disables /metrics. Generate a separate random 32+ byte operator token.
PAYFLOW_OPS_TOKEN=
