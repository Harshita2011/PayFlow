# Explicit test-only environment. Keep real values in ignored .env.test.
PAYFLOW_ENV=test
DATABASE_URL=postgresql+psycopg://anchor_role:YOUR_PASSWORD@127.0.0.1:5437/payflow_ci_anchor
PAYFLOW_TEST_DATABASE=payflow_ci_tests
PAYFLOW_TEST_DATABASE_URL=postgresql+psycopg://test_role:YOUR_PASSWORD@127.0.0.1:5437/payflow_ci_tests
JWT_SECRET_KEY=GENERATE_A_RANDOM_TEST_SECRET_AT_LEAST_32_BYTES
LOG_LEVEL=WARNING
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
